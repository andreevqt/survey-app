# Copy to .env on the VPS (cp .env.prod.example .env, then edit values).
# Used by docker-compose.prod.yml. Never commit .env.

POSTGRES_DB=survey_app
POSTGRES_USER=polls
POSTGRES_PASSWORD=change-me-strong-random

JWT_ACCESS_SECRET=change-me-long-random-string
JWT_REFRESH_SECRET=change-me-another-long-random-string

ADMIN_EMAIL=admin@andreevxdr.ru
ADMIN_PASSWORD=change-me-strong

# AI provider for free-text analytics. Leave blank to use the built-in mock.
DEEPSEEK_API_KEY=
# Optional model override; defaults to deepseek-chat.
# DEEPSEEK_MODEL=deepseek-chat
