            ]
          },
          "isActive": {
            "type": "boolean"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "responseCount": {
            "type": "number"
          },
          "createdAt": {
            "type": "string"
          },
          "questions": {
            "type": "array",
