          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionInputDto"
            }
          }
        },
        "required": [
          "title",
